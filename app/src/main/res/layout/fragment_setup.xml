<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:padding="24dp"
    android:gravity="center">

    <!-- App icon / hero area -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱"
        android:textSize="56sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doom Scroll Clock"
        android:textSize="28sp"
        android:textColor="@color/colorPlum"
        android:fontFamily="@font/dm_serif_display"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Two permissions. That\'s all."
        android:textSize="14sp"
        android:textColor="@color/colorMuted"
        android:textStyle="italic"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Overlay permission card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <View
                        android:id="@+id/dot_overlay"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_status"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display over other apps"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPlum" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shows the live timer pill above your feed"
                    android:textSize="12sp"
                    android:textColor="@color/colorMuted" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_overlay"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grant"
                android:textColor="@color/colorPrimary"
                app:strokeColor="@color/colorPrimary"
                app:cornerRadius="999dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Accessibility permission card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <View
                        android:id="@+id/dot_accessibility"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_status"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accessibility service"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPlum" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detects scrolling — no content is read"
                    android:textSize="12sp"
                    android:textColor="@color/colorMuted" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accessibility"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textColor="@color/colorPrimary"
                app:strokeColor="@color/colorPrimary"
                app:cornerRadius="999dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Continue button (only visible once both granted) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_continue"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Let\'s go"
        android:textSize="16sp"
        android:visibility="gone"
        app:cornerRadius="999dp"
        app:backgroundTint="@color/colorPrimary" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grant both permissions to continue"
        android:textSize="12sp"
        android:textColor="@color/colorMuted"
        android:gravity="center"
        android:layout_marginTop="16dp" />

</LinearLayout>
