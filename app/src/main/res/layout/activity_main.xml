<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="24dp">

    <!-- App title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doom Scroll Clock"
        android:textColor="@color/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="48dp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grant these two permissions once, then forget this app exists."
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Overlay permission row -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <View
                android:id="@+id/dot_overlay"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_status"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/label_overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/permission_overlay_title"
                android:textColor="@color/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/dot_overlay"
                app:layout_constraintEnd_toStartOf="@id/btn_overlay"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/desc_overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/permission_overlay_desc"
                android:textColor="#888888"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/dot_overlay"
                app:layout_constraintEnd_toStartOf="@id/btn_overlay"
                app:layout_constraintTop_toBottomOf="@id/label_overlay"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_overlay"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_grant"
                android:textColor="@color/colorOnSurface"
                app:strokeColor="@color/colorPrimaryVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Accessibility permission row -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/card_overlay"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <View
                android:id="@+id/dot_accessibility"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_status"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/label_accessibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/permission_accessibility_title"
                android:textColor="@color/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/dot_accessibility"
                app:layout_constraintEnd_toStartOf="@id/btn_accessibility"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/desc_accessibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/permission_accessibility_desc"
                android:textColor="#888888"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/dot_accessibility"
                app:layout_constraintEnd_toStartOf="@id/btn_accessibility"
                app:layout_constraintTop_toBottomOf="@id/label_accessibility"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accessibility"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_grant"
                android:textColor="@color/colorOnSurface"
                app:strokeColor="@color/colorPrimaryVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Status text -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_missing_permissions"
        android:textColor="#888888"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/card_accessibility"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
