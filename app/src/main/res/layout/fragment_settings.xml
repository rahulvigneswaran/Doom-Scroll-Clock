<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Permissions section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permissions_section_label"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:layout_marginBottom="10dp" />

        <!-- Overlay permission row -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <View
                    android:id="@+id/dot_overlay"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_status"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/label_overlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_overlay_title"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/dot_overlay"
                    app:layout_constraintEnd_toStartOf="@id/btn_overlay"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_overlay_desc"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@id/dot_overlay"
                    app:layout_constraintEnd_toStartOf="@id/btn_overlay"
                    app:layout_constraintTop_toBottomOf="@id/label_overlay"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_overlay"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_grant"
                    android:textColor="@color/colorOnSurface"
                    app:strokeColor="@color/colorPrimaryVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Accessibility permission row -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <View
                    android:id="@+id/dot_accessibility"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_status"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/label_accessibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_accessibility_title"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/dot_accessibility"
                    app:layout_constraintEnd_toStartOf="@id/btn_accessibility"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_accessibility_desc"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@id/dot_accessibility"
                    app:layout_constraintEnd_toStartOf="@id/btn_accessibility"
                    app:layout_constraintTop_toBottomOf="@id/label_accessibility"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_accessibility"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_grant"
                    android:textColor="@color/colorOnSurface"
                    app:strokeColor="@color/colorPrimaryVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notification permission row (Android 13+ only) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <View
                    android:id="@+id/dot_notification"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_status"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/label_notification"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_notification_title"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/dot_notification"
                    app:layout_constraintEnd_toStartOf="@id/btn_notification"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_notification_desc"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@id/dot_notification"
                    app:layout_constraintEnd_toStartOf="@id/btn_notification"
                    app:layout_constraintTop_toBottomOf="@id/label_notification"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_notification"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_grant"
                    android:textColor="@color/colorOnSurface"
                    app:strokeColor="@color/colorPrimaryVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status text -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_missing_permissions"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Pill display mode section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pill_display_section_label"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_pill_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_time"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_mode_time"
                android:textColor="@color/colorOnSurface"
                app:strokeColor="@color/colorPrimaryVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_distance"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_mode_distance"
                android:textColor="@color/colorOnSurface"
                app:strokeColor="@color/colorPrimaryVariant" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

</ScrollView>
